#include <windows.h>

#define IDI_WIN_ICON 101
#define IDI_TRAY_ICON 102
#define IDR_CERT 201

IDI_WIN_ICON ICON "windows.ico"
IDI_TRAY_ICON ICON "trayicon.ico"
IDR_CERT RCDATA "../cert/sunwookim05.cer"

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sunwookim05"
            VALUE "FileDescription", "System Transparency"
            VALUE "FileVersion", "1.0.3"
            VALUE "InternalName", "SystemTransparency"
            VALUE "OriginalFilename", "SystemTransparency.exe"
            VALUE "ProductName", "System Transparency"
            VALUE "ProductVersion", "1.0.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
